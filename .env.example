# crony 部署/本地开发环境变量样例
#
#   cp .env.example .env   然后填入真实值；.env 不要提交到仓库。
#
# 生成随机密钥：
#   openssl rand -hex 32
#
# 说明：所有 CRONY_* 变量都会覆盖 admin/conf|node/conf 里同名的配置项，
# 映射规则是 conf 的 a.b-c -> CRONY_A_B_C（点与横线都换成下划线）。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=crony
MYSQL_PASSWORD=change-me-crony-password

# ---------- admin API ----------
CRONY_ADMIN_PORT=8089

# ---------- 安全（必填） ----------
# JWT 签名密钥，>= 32 字节。生产环境不设置则 admin 拒绝启动（fail-fast）。
# 旧版本把该密钥硬编码在代码里，任何人都能伪造管理员令牌，务必替换。
CRONY_AUTH_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef
# 登录令牌有效期（小时），默认 168 = 7 天
CRONY_AUTH_TOKEN_EXPIRE_HOURS=168

# ---------- 首个管理员引导（必填，仅首次启动生效） ----------
# 用户表为空时创建该账号；口令 >= 8 位且不得为 123456/admin/password 等弱口令。
# 不设置则不会创建任何账号，改为允许"首个管理员引导注册"：POST /register。
CRONY_AUTH_BOOTSTRAP_ADMIN_USER=admin
CRONY_AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
CRONY_AUTH_BOOTSTRAP_ADMIN_EMAIL=ops@example.com

# 已存在用户后是否仍允许公开注册（默认 false，强烈建议保持 false）
CRONY_AUTH_ALLOW_PUBLIC_REGISTER=false

# ---------- 时区 ----------
TZ=Asia/Shanghai