# THIS IS ONLY FOR THE gitattributes REPOSITORY.
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
*               text=auto

#
# The above will handle all files NOT found below
#
# These files are text and should be normalized (Convert crlf => lf)
*.gitattributes text
.gitignore      text
*.md            text diff=markdown



#
# Enable syntax highlighting for files with `.gitattributes` extensions.
#
*.gitattributes linguist-language=gitattributes
*.js linguist-language=golang
*.css linguist-language=golang
*.html linguist-language=golang
*.vue linguist-language=golang

*.sh linguist-language=shell
*.go -text diff=golang

# 容器与编排文件统一 LF：Windows 检出时 CRLF 会导致 Dockerfile 构建异常
Dockerfile          text eol=lf
docker-compose.yml  text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.json              text eol=lf