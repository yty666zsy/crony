{
  "mysql": {
    "path": "127.0.0.1",
    "port": "3306",
    "config": "charset=utf8mb4&parseTime=True&loc=Local",
    "db-name": "crony",
    "username": "root",
    "password": "root",
    "max-idle-conns": 100,
    "max-open-conns": 100,
    "log-mode": "info",
    "log-zap": false
  },
  "system": {
    "env": "production",
    "addr": 8089,
    "#node-timeout": "Node registration timeout, in seconds",
    "node-ttl": 15,
    "#job-proc-ttl": "The unit is second",
    "job-proc-ttl": 300,
    "#log-clean-period":"The unit is minute. By default, it is cleared twice a day",
    "log-clean-period":720,
    "log-clean-expiration":604800,
    "#cmd-auto-allocation": "是否允许 cmd 类型任务自动分配节点。**只有 admin 读这个键**（见 admin/conf/*/main.json）——节点进程从不读它，所以这里不再提供取值，避免被误当成『节点自己会分配』。",
    "version": "v1.1.0"
  },
  "etcd": {
    "endpoints":[
      "http://127.0.0.1:2379"
    ],
    "username":"",
    "password":"",
    "dial-timeout": 2,
    "req-timeout": 5
  },
  "email": {
    "port": 465,
    "from": "from",
    "host": "smtp.qq.com",
    "is-ssl": true,
    "secret": "secret",
    "nickname": "crony定时任务平台",
    "#to": "Email default notification object",
    "to": ["test@qq.com"]
  },
  "webhook": {
    "url": "url",
    "kind": ""
  },
  "log": {
    "level": "warn",
    "format": "console",
    "prefix": "[crony-node]",
    "director": "logs",
    "showLine": false,
    "encode-level": "LowercaseLevelEncoder",
    "stacktrace-key": "stacktrace",
    "log-in-console": true
  },
  "tools": {
    "#policy": "阶段 4 工具网关策略（生产默认最保守）。",
    "allow-write": false,
    "allow-destructive": false,
    "autonomy": "L1",
    "auto-approve": [],
    "approval-ttl-seconds": 900,
    "max-calls-per-session": 12,
    "max-calls-per-tool": 4,
    "max-calls-per-minute": 60,
    "max-concurrent-calls": 4,
    "max-write-actions-per-session": 2,
    "max-affected-hosts-per-session": 1,
    "default-timeout-seconds": 15,
    "max-output-bytes": 65536,
    "allow-hosts": [],
    "shell-read-paths": ["/var/log/", "/var/log/crony/"],
    "sql-max-rows": 100,
    "deny": [],
    "allow": []
  }
}